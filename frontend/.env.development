# Loaded automatically by `npm run dev`. NOT secret: every NEXT_PUBLIC_ value ends up in the browser.
# Leave NEXT_PUBLIC_API_BASE empty: in development the app then calls the mock server on port 8787
# of whatever address you opened the page from (works from a phone on the same Wi-Fi too).
# Set it to a full URL to point the dev app at a real backend, e.g. https://<user>-<space>.hf.space
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_MOCK_PORT=8787
